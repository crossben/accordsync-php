{
    "name": "accordsync/monorepo",
    "description": "Monorepo of the Accord PHP packages.",
    "type": "project",
    "license": "Apache-2.0",
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "accordsync/core": "0.3.1",
                    "accordsync/server": "0.3.1",
                    "accordsync/laravel": "0.3.1",
                    "accordsync/symfony": "0.3.1"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.3",
        "accordsync/core": "^0.3",
        "accordsync/server": "^0.3",
        "accordsync/laravel": "^0.3",
        "accordsync/symfony": "^0.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "orchestra/testbench": "^11.3",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "symfony/framework-bundle": "^7.4"
    },
    "autoload-dev": {
        "psr-4": {
            "Accord\\Core\\Tests\\": "packages/core/tests/",
            "Accord\\Server\\Tests\\": "packages/server/tests/",
            "Accord\\Laravel\\Tests\\": "packages/laravel/tests/",
            "Accord\\Symfony\\Tests\\": "packages/symfony/tests/",
            "Accord\\Testing\\": "tools/testing/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "sync-contract": "php tools/sync-contract.php"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

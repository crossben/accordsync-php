APP_NAME=accord-example
APP_ENV=local
APP_DEBUG=false
LOG_CHANNEL=stderr

# Laravel's pgsql connection: Accord uses its PDO (accord.database.connection).
DB_CONNECTION=pgsql
DB_URL=postgres://accord:accord@127.0.0.1:55472/accord

# Rate-limit buckets: the file store (one host) supports atomic locks.
CACHE_STORE=file

ACCORD_DEFINITION=App\Accord\ConformanceDefinition
ACCORD_PREFIX=accord

# Test-only control API (token, reset, compact, age-device). Set it only on the control server.
# ACCORD_CONTROL_ENABLED is read from the process environment only (serve.sh sets it).

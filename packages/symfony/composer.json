{
    "name": "accordsync/symfony",
    "description": "Accord sync server for Symfony: bundle, configuration, routes and console commands.",
    "type": "symfony-bundle",
    "license": "Apache-2.0",
    "homepage": "https://accord.benhattab.pro",
    "keywords": [
        "offline-first",
        "sync",
        "crdt",
        "local-first"
    ],
    "require": {
        "php": ">=8.3",
        "accordsync/server": "^0.3",
        "symfony/http-kernel": "^7.2 || ^8.0",
        "symfony/config": "^7.2 || ^8.0",
        "symfony/dependency-injection": "^7.2 || ^8.0",
        "symfony/http-foundation": "^7.2 || ^8.0",
        "symfony/routing": "^7.2 || ^8.0",
        "symfony/console": "^7.2 || ^8.0",
        "symfony/cache": "^7.2 || ^8.0",
        "symfony/lock": "^7.2 || ^8.0",
        "nyholm/psr7": "^1.8",
        "psr/cache": "^2.0 || ^3.0",
        "psr/simple-cache": "^2.0 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "Accord\\Symfony\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Accord\\Symfony\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}

<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php" colors="true" cacheDirectory=".phpunit.cache"
         failOnWarning="true" failOnRisky="true">
    <testsuites>
        <testsuite name="core"><directory>packages/core/tests</directory></testsuite>
        <testsuite name="server"><directory>packages/server/tests</directory></testsuite>
        <testsuite name="laravel"><directory>packages/laravel/tests</directory></testsuite>
        <testsuite name="symfony"><directory>packages/symfony/tests</directory></testsuite>
    </testsuites>
</phpunit>
